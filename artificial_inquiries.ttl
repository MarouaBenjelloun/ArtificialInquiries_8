@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix o: <http://omeka.org/s/vocabs/o#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix artinq: <https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#> .

<https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#> a owl:Ontology ;
    dcterms:title "Artificial Inquiries" .


#################################################################
# Classes
#################################################################

artinq:Exercise a rdfs:Class ;
    rdfs:label "Exercise" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Partner a rdfs:Class ;
    rdfs:label "Partner" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Model a rdfs:Class ;
    rdfs:label "Model" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:AnimalCode a rdfs:Class ;
    rdfs:label "AnimalCode" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Task a rdfs:Class ;
    rdfs:label "Task" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Document a rdfs:Class ;
    rdfs:label "Document" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .

artinq:Response a rdfs:Class ;
    rdfs:label "Response" ;
    rdfs:domain o:Resource ;
    vs:term_status "experimental" .


#################################################################
# Data properties - attributes
#################################################################

artinq:id a rdf:Property ;
    rdfs:label "id" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:title a rdf:Property ;
    rdfs:label "title" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:description a rdf:Property ;
    rdfs:label "description" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:name a rdf:Property ;
    rdfs:label "name" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:instructions a rdf:Property ;
    rdfs:label "instructions" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:type a rdf:Property ;
    rdfs:label "type" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:taskId a rdf:Property ;
    rdfs:label "taskId" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:animalCode a rdf:Property ;
    rdfs:label "animalCode" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .

artinq:content a rdf:Property ;
    rdfs:label "content" ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    vs:term_status "experimental" .


#################################################################
# Object properties - relationships
#################################################################

artinq:contains a rdf:Property ;
    rdfs:label "contains" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Task ;
    vs:term_status "experimental" .

artinq:tests a rdf:Property ;
    rdfs:label "tests" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Model ;
    vs:term_status "experimental" .

artinq:assignsCode a rdf:Property ;
    rdfs:label "assigns code" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Model ;
    vs:term_status "experimental" .

artinq:provides a rdf:Property ;
    rdfs:label "provides" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Task ;
    vs:term_status "experimental" .

artinq:receives a rdf:Property ;
    rdfs:label "receives" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:AnimalCode ;
    vs:term_status "experimental" .

artinq:executes a rdf:Property ;
    rdfs:label "executes" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Task ;
    vs:term_status "experimental" .

artinq:produces a rdf:Property ;
    rdfs:label "produces" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Response ;
    vs:term_status "experimental" .

artinq:mayRequire a rdf:Property ;
    rdfs:label "may require" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Document ;
    vs:term_status "experimental" .

artinq:generates a rdf:Property ;
    rdfs:label "generates" ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:Response ;
    vs:term_status "experimental" .
